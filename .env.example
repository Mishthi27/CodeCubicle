# Copy to .env and adjust as needed.

# Central Qdrant server (Docker: docker run -p 6333:6333 qdrant/qdrant)
QDRANT_URL=http://localhost:6333

# Collection name on the server (created in Phase 3)
QDRANT_COLLECTION=field_memories

# When 1/true, the sync worker must skip all network calls (Phase 3+).
OFFLINE=0

# Trained policy is the default; set to rules for the Phase 4 fallback.
SYNC_POLICY=model

# Default simulated device id for the CLI.
DEVICE_ID=device-a
